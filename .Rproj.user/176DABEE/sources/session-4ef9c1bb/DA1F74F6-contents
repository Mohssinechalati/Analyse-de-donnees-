# 2.3 Quantiles et valeurs aberrantes
S <- c(200, 205, 210, 215, 220, 225, 230, 235, 240, 245, 450)
quantile(S, probs = c(.25, .5, .75), type = 2)   # méthode du cours : 210, 225, 240
quantile(S, probs = c(.25, .5, .75))             # type 7 par défaut

q <- quantile(S, probs = c(.25, .75), type = 2, names = FALSE)
iqr_S   <- q[2] - q[1]
lim_inf <- q[1] - 1.5 * iqr_S
lim_sup <- q[2] + 1.5 * iqr_S
c(lim_inf, lim_sup)                  # 165 et 285
S[S < lim_inf | S > lim_sup]         # 450

# Déciles, p5 / p95, résumé en 5 nombres sur USD/EUR
quantile(eur, probs = seq(.1, .9, by = .1))
quantile(eur, probs = c(.05, .95))
summary(eur)

# Valeurs aberrantes (règle 1,5 x IQR) sur l'EUR puis sur des devises plus
# "sauvages" : TRY, NGN, JPY
nb_aberrantes <- function(v) {
  v  <- v[!is.na(v)]
  q1 <- quantile(v, .25); q3 <- quantile(v, .75); i <- q3 - q1
  sum(v < q1 - 1.5 * i | v > q3 + 1.5 * i)
}
nb_aberrantes(histo$`USD/EUR`)   # 0
nb_aberrantes(histo$`USD/TRY`)   # ~ 1132
nb_aberrantes(histo$`USD/NGN`)   # ~ 720
nb_aberrantes(histo$`USD/JPY`)   # ~ 341

histo |>
  filter(`USD/TRY` > 30) |>
  select(Date, `USD/TRY`) |>
  arrange(desc(`USD/TRY`)) |>
  slice_head(n = 5)
