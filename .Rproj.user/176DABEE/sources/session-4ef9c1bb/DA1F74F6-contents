# 1.3 Variable ordinale : maximum local
# Aucune variable ordinale dans les CSV : on en construit une en découpant
# USD/EUR en 5 niveaux ordonnés (feature engineering).
eur <- histo |> drop_na(`USD/EUR`) |> pull(`USD/EUR`)

niveau_eur <- cut(eur,
                  breaks = c(0.6, 0.7, 0.8, 0.9, 1.0, 1.1),
                  labels = c("Très faible", "Faible", "Moyen", "Élevé", "Très élevé"),
                  right = FALSE, ordered_result = TRUE)
levels(niveau_eur)
f <- table(niveau_eur)
f
n <- length(f)
est_max_local <- sapply(seq_len(n), function(i) {
  gauche <- if (i > 1) f[i - 1] else -Inf
  droite <- if (i < n) f[i + 1] else -Inf
  f[i] >= gauche & f[i] >= droite
})
names(f)[est_max_local]

tibble(niveau = niveau_eur) |>
  count(niveau, name = "freq_abs") |>
  mutate(freq_rel = freq_abs / sum(freq_abs),
         freq_cum = cumsum(freq_rel))
# Q1.3 Réponse : effectifs ~ 443 / 2046 / 2272 / 1719 / 64. Il y a un seul
#   maximum local : "Moyen" (0,8 à 0,9 euro pour 1 dollar). La fréquence
#   cumulée donne la proportion de jours où le taux est inférieur ou égal à un
#   niveau (ex. ~ 73 % des jours à "Moyen" ou moins). Elle n'a de sens que pour
#   une variable ordinale, car il faut un ordre des modalités.

