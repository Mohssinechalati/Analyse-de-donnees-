    moyenne = mean(`USD/EUR`, na.rm = TRUE),
    .groups = "drop"
  )

stats_journalieres

# Graphique : taux moyen selon le jour du mois
ggplot(stats_journalieres, aes(x = jour, y = moyenne)) +
  geom_line(color = "darkgreen", linewidth = 1) +
  geom_point(color = "darkgreen") +
  scale_x_continuous(breaks = 1:31) +
  labs(
    title = "Taux moyen USD/EUR selon le jour du mois",
    x = "Jour du mois",
    y = "Taux moyen USD/EUR"
  ) +
  theme_minimal()

