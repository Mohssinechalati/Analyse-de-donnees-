# Dispersion par groupe : les devises n'ont pas la même unité (1 USD = 0,8 EUR
# mais 1 USD = 23 000 VND), donc on compare avec le coefficient de variation.
histo_long <- histo |>
  pivot_longer(-Date, names_to = "conversion", values_to = "taux") |>
  left_join(devises, by = "conversion")

disp_devise <- histo_long |>
  group_by(type_eco, conversion) |>
  summarise(moyenne    = mean(taux, na.rm = TRUE),
            ecart_type = sd(taux,   na.rm = TRUE),
            cv         = ecart_type / moyenne,
            .groups = "drop") |>
  arrange(cv)
disp_devise

disp_devise |>
  group_by(type_eco) |>
  summarise(cv_moyen = mean(cv), cv_max = max(cv))
# Q2.5 Réponse :
#  (a) Variance n : 0,0073927 ; variance n-1 : 0,0073939. La différence est
#      négligeable ici (n = 6544) ; elle compterait sur un petit échantillon.
#  (b) Sur l'ecart-type brut, la devise la plus dispersée est le VND/IDR
#      (très grandes valeurs), mais c'est un artefact d'unité. Avec le
#      coefficient de variation : SGD (5,7 %) la plus stable ; TRY (130 %) puis
#      NGN (104 %) les plus dispersées.
#  (c) En finance, la dispersion EST l'information : c'est la volatilité,
#      donc le risque de change ; une devise stable (SGD, CNY) s'oppose à une
#      devise très instable (TRY, NGN).

